#!/usr/bin/python3
"""Explicit, capability-limited Mac integration from a developer environment."""
import base64
import fcntl
import json
import os
from pathlib import Path
import secrets
import select
import sys
import time

limit = 16 * 1024 * 1024
if len(sys.argv) < 2 or sys.argv[1] not in ('open', 'copy', 'paste', 'export'):
    sys.exit('usage: uvm-host open URL | copy < TEXT | paste | export FILE (up to 16 MiB)')
method = sys.argv[1]
if method in ('open', 'export') and len(sys.argv) != 3:
    sys.exit('open and export require one argument')
request = {'id': secrets.randbits(48), 'action': method}
if method == 'open':
    request['url'] = sys.argv[2]
elif method in ('copy', 'export'):
    stream = open(sys.argv[2], 'rb') if method == 'export' else sys.stdin.buffer
    data = stream.read(limit + 1)
    if len(data) > limit:
        sys.exit('payload exceeds 16 MiB')
    request['data'] = base64.b64encode(data).decode()
    if method == 'export':
        request['name'] = Path(sys.argv[2]).name
folder = Path.home() / '.cache/uvm'
folder.mkdir(parents=True, exist_ok=True, mode=0o700)
with open(folder / 'host.lock', 'a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    fd = os.open('/dev/virtio-ports/org.ubuntu.vm.host', os.O_RDWR | os.O_NONBLOCK)
    try:
        message = json.dumps(request).encode() + b'\n'
        deadline = time.monotonic() + 30
        while message:
            if time.monotonic() > deadline:
                sys.exit('Mac integration did not answer')
            if select.select([], [fd], [], 1)[1]:
                message = message[os.write(fd, message):]
        buffer = bytearray()
        while time.monotonic() < deadline:
            if not select.select([fd], [], [], 1)[0]:
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                time.sleep(.1)
                continue
            buffer.extend(chunk)
            if len(buffer) > limit * 4 // 3 + 4096:
                sys.exit('invalid Mac integration response')
            while b'\n' in buffer:
                line, _, remainder = buffer.partition(b'\n')
                buffer[:] = remainder
                reply = json.loads(line)
                if reply.get('id') != request['id']:
                    continue
                if not reply.get('ok'):
                    sys.exit(reply.get('error', 'Mac request refused'))
                if method == 'paste':
                    sys.stdout.buffer.write(base64.b64decode(reply['data'], validate=True))
                elif method == 'export':
                    print(reply['name'])
                sys.exit(0)
        sys.exit('Mac integration did not answer')
    finally:
        os.close(fd)
